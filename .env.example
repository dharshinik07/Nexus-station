# FreelanceVault Environment Variables Template

# PostgreSQL Credentials
POSTGRES_USER=freelancevault
POSTGRES_PASSWORD=vaultsecurepass
POSTGRES_DB=freelancevault

# Database Connection (for backend standalone)
DATABASE_URL=postgresql://freelancevault:vaultsecurepass@localhost:5432/freelancevault?schema=public

# Application URLs
FRONTEND_URL=http://localhost:3000
PORT=5000

# Authentication & Session Security
JWT_ACCESS_SECRET=your-super-secret-access-token-key-min-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECURE=false

# Field-level & File Encryption at Rest (AES-256-GCM)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=a1b2c3d4e5f60718293a4b5c6d7e8f90a1b2c3d4e5f60718293a4b5c6d7e8f90

# Storage
STORAGE_DIR=./uploads
MAX_FILE_SIZE_MB=15

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=20
