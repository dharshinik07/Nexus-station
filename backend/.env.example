NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://freelancevault:vaultsecurepass@localhost:5432/freelancevault?schema=public"

# Security & JWT
JWT_ACCESS_SECRET="super-secret-access-token-key-change-in-production-min-32-chars-long"
JWT_REFRESH_SECRET="super-secret-refresh-token-key-change-in-production-min-32-chars-long"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# AES-256-GCM Encryption Key (must be exactly 32 bytes hex encoded = 64 hex chars, or 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Storage
STORAGE_DIR="./uploads"
MAX_FILE_SIZE_MB=15

# Session & Security
COOKIE_SECURE=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10
